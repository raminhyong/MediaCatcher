<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MediaCatcher.App.Localization"
        xmlns:vm="using:MediaCatcher.App.ViewModels"
        x:Class="MediaCatcher.App.Views.FirstRunWindow"
        x:DataType="vm:FirstRunViewModel"
        Title="{loc:Loc FirstRunTitle}"
        Width="620"
        Height="580"
        CanResize="False"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource PanelAltBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="26,24,26,20">
    <StackPanel Spacing="4">
      <TextBlock Text="{loc:Loc FirstRunTitle}"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryText}" />
      <TextBlock Text="{loc:Loc FirstRunIntro}" Classes="hint" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,18,0,12">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SetupCheck">
              <Border Background="{DynamicResource PanelBackground}"
                      BorderBrush="{DynamicResource PanelBorder}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="14,12"
                      Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="●"
                             FontSize="16"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SuccessBrush}"
                             IsVisible="{Binding IsOk}" />
                  <TextBlock Text="●"
                             FontSize="16"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource DangerBrush}"
                             IsVisible="{Binding !IsOk}" />
                  <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Text="{Binding Detail}" Classes="hint" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{loc:Loc ReadyStatus}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SuccessBrush}"
                             IsVisible="{Binding IsOk}" />
                  <TextBlock Grid.Column="2"
                             Text="{loc:Loc Missing}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource DangerBrush}"
                             IsVisible="{Binding !IsOk}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasMessage}"
                Background="{DynamicResource PanelAltBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9">
          <TextBlock Text="{Binding Message}" Classes="hint" Foreground="{DynamicResource PrimaryText}" />
        </Border>

        <TextBlock Text="{loc:Loc ExtensionsHint}" Classes="hint" Margin="0,6,0,0" />
        <TextBlock Text="{loc:Loc InstallHostHint}" Classes="hint" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Content="{loc:Loc Refresh}" Command="{Binding RefreshCommand}" />
        <Button Classes="secondary" Content="{loc:Loc RegisterHost}" Command="{Binding RegisterHostCommand}" />
        <Button Classes="secondary" Content="{loc:Loc OpenExtensionFolder}" Command="{Binding OpenExtensionFolderCommand}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Content="{loc:Loc Close}" Command="{Binding CloseCommand}" MinWidth="110" />
    </Grid>
  </Grid>
</Window>
